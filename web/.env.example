# ── Database (required in production) ───────────────────────────────────────
# Without these the API falls back to an in-memory store on Vercel, which is
# NOT persistent (the UI warns about it). Run supabase/migrations/001_init.sql,
# supabase/seeds/001_seed.sql and supabase/migrations/002_places_votes.sql first.
SUPABASE_URL=https://your-project.supabase.co
# Server-only key (Project Settings → API → service_role). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS gateway for SOS (optional) ──────────────────────────────────────────
# Without it the SOS screen offers a native SMS to trusted contacts instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Routing (optional overrides) ────────────────────────────────────────────
# VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
